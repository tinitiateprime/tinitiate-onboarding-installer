# Copy this file to .env and change every password used by your selected environment.
CODE_SERVER_PASSWORD=change-me-code

# Host ports can be changed when the defaults are already in use.
CODE_SERVER_PORT=8080
FLOCI_UI_PORT=4500
FLOCI_AWS_PORT=4566
FLOCI_AZURE_PORT=4577
FLOCI_GCP_PORT=4588

# Base64 for "local-floci-student-key". This is local test data, not a cloud key.
FLOCI_AZURE_ACCOUNT_KEY=bG9jYWwtZmxvY2ktc3R1ZGVudC1rZXk=

# Defaults used only by the matching cloud environment.
AWS_DEFAULT_REGION=us-east-1
GCP_PROJECT_ID=floci-local

# Optional on-premises database overrides. Its YAML works without these values.
DATABASE_TIMEZONE=America/Chicago
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=change-me-Mssql1!
POSTGRES_PORT=5432
POSTGRES_USER=tinitiate
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=tinitiate
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-MysqlRoot1!
MYSQL_DATABASE=tinitiate
MYSQL_USER=tinitiate
MYSQL_PASSWORD=change-me-mysql
